          "4-Orbit/another-test"
        ]
      },
      "until": 1800000000
    },
    "cedar": "@id(\"github-agent-create-until\")\npermit (\n  principal == Agent::\"developer-agent\",\n  action == Action::\"github.issue.Create\",\n  resource\n)\nwhen { resource in [Repository::\"4-Orbit/orbitport-issue-test\", Repository::\"4-Orbit/another-test\"] \u0026\u0026 context.currentTime \u003c 1800000000 };",
    "json": {
      "annotations": {
        "id": "github-agent-create-until"
      },
      "effect": "permit",
      "principal": {
        "op": "==",
        "entity": {
          "type": "Agent",
          "id": "developer-agent"
        }
      },
      "action": {
        "op": "==",
        "entity": {
          "type": "Action",
          "id": "github.issue.Create"
        }
      },
      "resource": {
        "op": "All"
      },
      "conditions": [
        {
          "kind": "when",
          "body": {
            "\u0026\u0026": {
              "left": {
                "in": {
                  "left": {
                    "Var": "resource"
                  },
                  "right": {
                    "Set": [
                      {
                        "Value": {
                          "__entity": {
                            "type": "Repository",
                            "id": "4-Orbit/orbitport-issue-test"
                          }
                        }
                      },
                      {
                        "Value": {
                          "__entity": {
                            "type": "Repository",
                            "id": "4-Orbit/another-test"
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "right": {
                "\u003c": {
                  "left": {
                    ".": {
                      "left": {
                        "Var": "context"
                      },
                      "attr": "currentTime"
                    }
                  },
                  "right": {
                    "Value": 1800000000
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
