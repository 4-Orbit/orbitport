        "op": "in",
        "entities": [
          {
            "type": "Action",
            "id": "kms.Sign"
          },
          {
            "type": "Action",
            "id": "read"
          }
        ]
      },
      "resource": {
        "op": "All"
      },
      "conditions": [
        {
          "kind": "when",
          "body": {
            "\u0026\u0026": {
              "left": {
                "in": {
                  "left": {
                    "Var": "resource"
                  },
                  "right": {
                    "Set": [
                      {
                        "Value": {
