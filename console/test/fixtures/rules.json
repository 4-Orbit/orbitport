      "annotations": {
        "id": "deny-agents-prod"
      },
      "effect": "forbid",
      "principal": {
        "op": "is",
        "entity_type": "Agent"
      },
      "action": {
        "op": "All"
      },
      "resource": {
        "op": "All"
      },
      "conditions": [
        {
          "kind": "when",
          "body": {
            "\u0026\u0026": {
              "left": {
                "hasTag": {
                  "left": {
                    "Var": "resource"
                  },
                  "right": {
                    "Value": "env"
                  }
                }
              },
              "right": {
                "==": {
                  "left": {
                    "getTag": {
                      "left": {
                        "Var": "resource"
                      },
                      "right": {
                        "Value": "env"
                      }
                    }
                  },
                  "right": {
                    "Value": "prod"
                  }
                }
              }
            }
          }
        }
      ]
    }
