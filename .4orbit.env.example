# 4Orbit overlay settings. Copy to .4orbit.env (git-ignored). Defaults are fine
# for local development.

# enforce = DENY blocks the KMS call; shadow = evaluate + audit, never block.
ORBITPORT_KMS_AUTHZ_MODE=enforce
# How quickly an activated policy version reaches the KMS plugin.
ORBITPORT_KMS_POLICY_CACHE_TTL_SECS=5

# Agent PAT lifetime bounds enforced by plugin-patissuer.
ORBITPORT_PATISSUER_MIN_TTL_SECS=60
ORBITPORT_PATISSUER_AGENT_MAX_TTL_SECS=86400

# Lifetimes the seed uses (seconds).
FOURORBIT_AGENT_TOKEN_TTL=3600
FOURORBIT_OPERATOR_TOKEN_TTL=43200

# Decision events kept in memory per tenant by plugin-policy.
ORBITPORT_POLICY_AUDIT_RING=2000

# Console port on 127.0.0.1.
ORBITPORT_CONSOLE_PORT=4317

# Set to true for one `make 4orbit-seed` to reload the 4Orbit template as a
# new policy version even if one is already active.
FOURORBIT_RESEED=false
