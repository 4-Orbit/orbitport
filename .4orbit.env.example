# 4Orbit overlay settings. Copy to .4orbit.env (git-ignored). Defaults are fine
# for local development.

# enforce = DENY blocks the KMS call; shadow = evaluate + audit, never block.
ORBITPORT_KMS_AUTHZ_MODE=enforce
# How quickly an activated policy version reaches the KMS plugin.
ORBITPORT_KMS_POLICY_CACHE_TTL_SECS=5

# Agent PAT lifetime bounds enforced by plugin-patissuer.
ORBITPORT_PATISSUER_MIN_TTL_SECS=60
ORBITPORT_PATISSUER_AGENT_MAX_TTL_SECS=86400

# Lifetimes the seed uses (seconds).
FOURORBIT_AGENT_TOKEN_TTL=3600
FOURORBIT_OPERATOR_TOKEN_TTL=43200

# Decision events kept in memory per tenant by plugin-policy.
ORBITPORT_POLICY_AUDIT_RING=2000

# Console port on 127.0.0.1.
ORBITPORT_CONSOLE_PORT=4317

# Set to true for one `make 4orbit-seed` to reload the 4Orbit template as a
# new policy version even if one is already active.
FOURORBIT_RESEED=false

# GitHub issues. Mock never contacts GitHub. For real issues, install the App
# with Issues: write on this repository, then copy your downloaded PEM to
# .4orbit/github/app.pem in this repo (git-ignored; chmod 600). Compose mounts
# that fixed location into plugin-github; no PEM file path goes in this env file.
# Example: mkdir -p .4orbit/github && cp /path/to/downloaded-key.pem .4orbit/github/app.pem && chmod 600 .4orbit/github/app.pem
ORBITPORT_GITHUB_MODE=mock
ORBITPORT_GITHUB_REPOSITORY=demo-owner/orbitport-test
ORBITPORT_GITHUB_TENANT=noop-tenant
ORBITPORT_GITHUB_APP_ID=
ORBITPORT_GITHUB_INSTALLATION_ID=

# Gemini issue creation in the main Docker console. Paste your Gemini API key
# after the equals sign in your private .4orbit.env file. It is passed to the
# console container at runtime, never to the browser or Docker image.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
