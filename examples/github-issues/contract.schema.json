{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orbitport:github-issue-request:v1",
  "title": "Orbitport GitHub issue request v1",
  "description": "Bearer credentials travel separately. Identity and token expiry come from trusted validation. Request ID is generated by the server.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "action", "repository", "title", "body"],
  "properties": {
    "version": { "const": 1 },
    "action": { "const": "github.issue.create" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/(?!\\.{1,2}$)[A-Za-z0-9_.-]{1,100}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
    "body": { "type": "string", "maxLength": 16384 }
  }
}
