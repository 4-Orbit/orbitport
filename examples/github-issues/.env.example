# Standalone prototype only. The main Docker console uses ../../.4orbit.env.
# Its Gemini key goes in GEMINI_API_KEY there, and its GitHub PEM is copied to
# ../../.4orbit/github/app.pem (no private-key path env variable).
GITHUB_APP_ID=your-app-id
GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/your-private-key.pem
GITHUB_TEST_REPOSITORY=laurenc06/orbitport-issue-test
CONSOLE_PORT=4322
