// Orbitport agent-authorization schema (4Orbit merge).
//
// Actions are the gateway RPC method names, grouped under 4Orbit's
// vocabulary (use / rotate / read / admin) so a policy can say either
// `action == Action::"kms.Encrypt"` or `action in Action::"use"`.
//
// Every resource carries `tenant`; the platform policy fences tenants.
// `context.currentTime` is set by the enforcing plugin's trusted clock. GitHub
// actions add trusted context computed by plugin-github from GitHub, never from
// the caller (D-035); each such action declares its context type below.

entity Role;
entity Account { tenant: String };
entity Agent in [Role] { tenant: String };
entity Key {
  tenant: String,
  scheme: String,
  keySpec: String,
  keyUsage: String,
} tags String;
entity KeyNamespace { tenant: String };
entity KeyStoreKey { tenant: String, name: String };
entity KeyStoreNamespace { tenant: String, prefix: String };
entity PolicySet { tenant: String };
entity Repository { tenant: String, owner: String, name: String };

type TrustedContext = { currentTime: Long };
// The repository path the read targets ("" is the root).
type ContentsContext = { currentTime: Long, path: String };
// A branch write. branchAgent is the agent an agent/<agent-id>/... branch
// belongs to, so a policy can say "only your own branches".
type BranchContext = { currentTime: Long, branch: String, isDefaultBranch: Bool, branchAgent?: Agent };
// A commit: the branch fields, every path it adds, changes or deletes, and
// whether any of them is under .github/workflows/.
type CommitContext = {
  currentTime: Long,
  branch: String,
  isDefaultBranch: Bool,
  branchAgent?: Agent,
  paths: Set<String>,
  touchesWorkflows: Bool,
};

action "use", "rotate", "read", "admin", "keystore", "policy", "github.write", "github.read", "github.code";

action "github.branch.Create" in ["github.code"] appliesTo {
  principal: [Account, Agent],
  resource: [Repository],
  context: BranchContext,
};

action "github.commit.Create" in ["github.code"] appliesTo {
  principal: [Account, Agent],
  resource: [Repository],
  context: CommitContext,
};

action "github.contents.Read" in ["github.read"] appliesTo {
  principal: [Account, Agent],
  resource: [Repository],
  context: ContentsContext,
};

action "github.issue.Create", "github.issue.Comment" in ["github.write"] appliesTo {
  principal: [Account, Agent],
  resource: [Repository],
  context: TrustedContext,
};

action "kms.Encrypt", "kms.Decrypt", "kms.Sign", "kms.GenerateDataKey", "kms.Encapsulate", "kms.Decapsulate" in ["use"] appliesTo {
  principal: [Account, Agent],
  resource: [Key],
  context: TrustedContext,
};

action "kms.RotateKey" in ["rotate"] appliesTo {
  principal: [Account, Agent],
  resource: [Key],
  context: TrustedContext,
};

action "kms.GetKeyMetadata", "kms.GetPublicKey" in ["read"] appliesTo {
  principal: [Account, Agent],
  resource: [Key],
  context: TrustedContext,
};

action "kms.ListKeys" in ["read"] appliesTo {
  principal: [Account, Agent],
  resource: [KeyNamespace],
  context: TrustedContext,
};

action "kms.CreateKey" in ["admin"] appliesTo {
  principal: [Account, Agent],
  resource: [Key],
  context: TrustedContext,
};

action "kms_keystore.Put", "kms_keystore.Get", "kms_keystore.Delete" in ["keystore"] appliesTo {
  principal: [Account, Agent],
  resource: [KeyStoreKey],
  context: TrustedContext,
};

action "kms_keystore.List" in ["keystore"] appliesTo {
  principal: [Account, Agent],
  resource: [KeyStoreNamespace],
  context: TrustedContext,
};

action "policy.Read", "policy.Write", "policy.Activate", "policy.Simulate", "policy.IssueAgentToken" in ["policy"] appliesTo {
  principal: [Account, Agent],
  resource: [PolicySet],
  context: TrustedContext,
};
