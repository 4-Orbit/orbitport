# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

plugins/bin/

# env file
.env

.DS_Store

.idea
.vscode

.data/

.backup

# Generated by Cargo
# will have compiled files and executables
debug/
target/

.omc/
# Sibling OpenBao plugin repos, checked out here by the e2e workflow.
openbao-eth-plugin/
openbao-threshold-plugin/

# Local agent/editor config
.claude/

# 4Orbit local state: seeded tokens and overlay settings
.4orbit/
.4orbit.env

# Console build output and dependencies
console/node_modules/
console/dist/
console/test-results/
console/playwright-report/
